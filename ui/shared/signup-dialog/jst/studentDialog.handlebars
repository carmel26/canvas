<div class="registration-dialog">
  <form class="form-horizontal bootstrap-form" method="post" action="/users">
    <div class="ic-Form-control">
      <label class="ic-Label" for="student_join_code">{{#t "labels.join_code"}}Join Code{{/t}}</label>
      <input class="ic-Input" type="text" id="student_join_code" name="user[self_enrollment_code]">
    </div>
    <div class="ic-Form-control">
      <label class="ic-Label" for="student_name">{{#t "labels.name"}}Full Name{{/t}}</label>
      <input class="ic-Input" type="text" id="student_name" name="user[name]">
    </div>
    <div class="ic-Form-control">
      <label class="ic-Label" for="student_username">{{#t "labels.username"}}Username{{/t}}</label>
      <input class="ic-Input" type="text" id="student_username" name="pseudonym[unique_id]">
    </div>
    <div class="ic-Form-control">
      <label class="ic-Label" for="student_password">{{#t "labels.password"}}Password{{/t}}</label>
      <input class="ic-Input" type="password" id="student_password" name="pseudonym[password]">
    </div>
    <div class="ic-Form-control">
      <label class="ic-Label" for="student_password_confirmation">{{#t "labels.password_confirmation"}}Confirm Password{{/t}}</label>
      <input class="ic-Input" type="password" id="student_password_confirmation" name="pseudonym[password_confirmation]">
    </div>
    {{#if require_email}}
    <div class="ic-Form-control">
      <label class="ic-Label" for="student_email">{{#t "labels.email"}}Email{{/t}}</label>
      <input class="ic-Input" type="email" id="student_email" name="pseudonym[path]">
    </div>
    {{/if}}
    {{#if terms_required}}
    <div class="ic-Form-control">
      <label class="checkbox" for="student_terms">
        <input type="checkbox" id="student_terms" name="user[terms_of_use]" value="1">
        {{{terms_html}}}
      </label>
    </div>
    {{/if}}
    {{#if recaptcha}}
    <div class="ic-Form-control">
      <div class="g-recaptcha"></div>
    </div>
    {{/if}}
    <div class="ic-Form-control">
      <input type="hidden" name="user[initial_enrollment_type]" value="student">
      <input type="hidden" name="self_enrollment" value="1">
      <input type="hidden" name="pseudonym_type" value="username">
      <div class="button-container">
        <button class="btn btn-secondary dialog_closer" type="button">{{#t "buttons.cancel"}}Cancel{{/t}}</button>
        <button class="btn btn-primary" type="submit">{{#t "buttons.start_learning"}}Start Learning{{/t}}</button>
      </div>
    </div>
  </form>
</div>
