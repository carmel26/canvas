<div class="registration-dialog">
  <form class="form-horizontal bootstrap-form" method="post" action="/users">
    <div class="ic-Form-control">
      <label class="ic-Label" for="teacher_name">{{#t "labels.name"}}Name{{/t}}</label>
      <input class="ic-Input" type="text" id="teacher_name" name="user[name]">
    </div>
    <div class="ic-Form-control">
      <label class="ic-Label" for="teacher_email">{{#t "labels.email"}}Email{{/t}}</label>
      <input class="ic-Input" type="email" id="teacher_email" name="pseudonym[unique_id]">
    </div>
    {{#if terms_required}}
    <div class="ic-Form-control">
      <label class="checkbox" for="teacher_terms">
        <input type="checkbox" id="teacher_terms" name="user[terms_of_use]" value="1">
        {{{terms_html}}}
      </label>
    </div>
    {{/if}}
    {{#if recaptcha}}
    <div class="ic-Form-control">
      <div class="g-recaptcha"></div>
    </div>
    {{/if}}
    <div class="ic-Form-control">
      <input type="hidden" name="user[initial_enrollment_type]" value="teacher">
      <div class="button-container">
        <button class="btn btn-secondary dialog_closer" type="button">{{#t "buttons.cancel"}}Cancel{{/t}}</button>
        <button class="btn btn-primary" type="submit">{{#t "buttons.start_teaching"}}Start Facilitating{{/t}}</button>
      </div>
    </div>
  </form>
</div>
