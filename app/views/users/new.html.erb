<%
  js_bundle :terms_of_service_modal, :registration
  css_bundle :registration
  provide :page_title, t('create_a_canvas_account', "Create a Mwecau LMS Account")
  provide :head, include_common_stylesheets
%>


<div id="main" class="mwenge-registration">
  <div id="registration_header">
    <div class="registration-content">
      <a class="registration-brand" href="/">
        <%= image_tag("mwecau-logo.png", alt: "Mwenge Catholic University") %>
        <span>Lux Mundi</span>
      </a>
      <a id="registration_login" href="/login"><%= t("Log in") %></a>
    </div>
  </div>

  <div id="registration_content">
    <div class="registration-content">
      <section class="registration-welcome" aria-labelledby="registration-welcome-title">
        <p class="registration-eyebrow"><%= t("Mwenge Catholic University") %></p>
        <h1 id="registration-welcome-title"><%= t("Lux Mundi") %></h1>
        <p><%= t("Join our learning community and begin your journey at Mwenge Catholic University.") %></p>
        <% if (url = Setting.get('registration_video', nil).presence) %>
          <% js_env({ REGISTRATION_VIDEO_URL: Setting.get('registration_video_url_with_play_params', nil).presence }) %>
          <h2 id="registration_video"><a href="<%= url %>" title="Play the Canvas introduction video"><%= t("Watch a Video") %></a></h2>
        <% end %>
      </section>
      <div id="registration_options" aria-labelledby="registration-options-title">
        <h2 id="registration-options-title"><%= t("Create your account") %></h2>
        <p><%= t("Choose the account type that best describes you.") %></p>
        <div class="registration-actions">
          <% if (url = @domain_root_account.settings[:fft_registration_url]) %>
            <a id="signup_teacher" class="registration-choice registration-choice--teacher" href="<%= url %>" title="Teacher Signup"><%= t("I'm a Teacher") %></a>
          <% else %>
            <a href="#" id="signup_teacher" class="signup_link registration-choice registration-choice--teacher" data-template="teacherDialog" title="Teacher Signup"><%= t("I'm a Teacher") %></a>
          <% end %>
          <a href="#" id="signup_student" class="signup_link registration-choice" data-template="studentDialog" title="Student Signup"><%= t("I'm a Student") %></a>
        </div>
        <div class="registration-parent-signup"><%= link_to_parent_signup(nil) %></div>
      </div>
    </div>
  </div>

  <div id="registration_footer">
    <div class="registration-content">
      <div class="left">&copy; <%= Time.now.year %> <%= t("Mwenge Catholic University") %></div>
      <div class="right">
        <span href="#" class="terms_of_service_link" id="terms_of_service_link"></span>
        <%= link_to t(:privacy_policy, 'Privacy Policy'), privacy_policy_url, class: "mwenge-privacy-policy-link" %>
      </div>
    </div>
  </div>
</div>
