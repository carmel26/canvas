<%
  js_bundle :change_password
%>

<% provide :page_title do %><%= t :page_title, "Change Password" %><% end %>

<div style="position: fixed; inset: 0; overflow-y: auto; display: grid; place-items: center; padding: 24px; box-sizing: border-box; background: linear-gradient(135deg, #262e7d 0%, #3a45ab 55%, #5c68d6 100%);">
  <div style="width: 100%; max-width: 460px; background: #fff; border-radius: 14px; box-shadow: 0 24px 60px rgba(14, 25, 45, 0.35); overflow: hidden;">
    <div style="padding: 28px 32px 0; text-align: center;">
      <%= image_tag("mwecau-logo.png", alt: "Mwenge Catholic University", style: "height: 72px; width: auto;") %>
      <p style="margin: 8px 0 0; color: #3a45ab; font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;">Lux Mundi</p>
    </div>
    <div id="confirm_change_password_mount_point" style="padding: 8px 16px 24px;">
      <span><%= t "confirm_change_password.loading", "Loading..." %></span>
    </div>
  </div>
</div>
